{
    "name": "AI ClipCatcher",
    "description": "AI ClipCatcher is a Chrome extension that helps you find AI tools and resources.",
    "version": "1.0.4",
    "author": "Kamruzzaman",
    "manifest_version": 3,
    "permissions": ["tabs", "activeTab", "storage", "contextMenus", "downloads"],
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
        "16": "icons/favicon.png",
        "32": "icons/favicon.png",
        "48": "icons/favicon.png",
        "128": "icons/favicon.png"
    },
    "action": {
        "default_icon": {
            "16": "icons/favicon.png",
            "32": "icons/favicon.png",
            "48": "icons/favicon.png",
            "128": "icons/favicon.png"
        },
        "default_popup": "index.html"
    },
    "content_scripts": [
        {
            "matches": ["http://127.0.0.1:5500/*", "https://sora.chatgpt.com/*"],
            "js": ["script.js"]
        }
    ]
}
